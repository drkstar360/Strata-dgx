diff --git a/Dockerfile.spark b/Dockerfile.spark
new file mode 100644
index 0000000..3f0017e
--- /dev/null
+++ b/Dockerfile.spark
@@ -0,0 +1,95 @@
+# syntax=docker/dockerfile:1
+#
+# Strata on an NVIDIA DGX Spark (GB10 Grace Blackwell, aarch64, 128 GB unified
+# memory): docs/DGX_SPARK.md.  The same image as ./Dockerfile - entrypoint, /data
+# volume, env vars - with the engine compiled for sm_121 and for the Grace CPU.
+#
+# Build it ON THE SPARK (the base image is multi-arch, so docker pulls arm64 there;
+# Docker Desktop on an x86 PC would make an amd64 image that cannot run on it):
+#   docker build -f Dockerfile.spark -t strata-spark .
+#   docker image inspect strata-spark --format '{{.Architecture}}'     # arm64
+#
+# Run (DGX OS ships the driver and the NVIDIA container runtime):
+#   docker run -d --name strata --gpus all -p 127.0.0.1:8080:8080 #     --ulimit memlock=-1 -v strata-data:/data #     -e FAMILY=unsloth -e MODEL=UD-IQ4_XS strata-spark
+#
+# Setup choices are the env vars ./Dockerfile lists (FAMILY, MODEL, CONTEXT, VISION,
+# KV, LOW_RAM, HOST, PORT, API_KEY, GGUF_DIR, MODEL_ALIASES, ...).  Q2_0 is not offered on ARM:
+# its pack needs Strata's x86 AVX-512 kernels.  Add -e API_KEY=<secret> before
+# publishing the port beyond 127.0.0.1.
+
+FROM nvidia/cuda:13.0.0-devel-ubuntu24.04
+
+# STRATA_EXECV=1: setup.py replaces itself with the server, so the server is PID 1
+# and docker stop's SIGTERM reaches it (see setup.start). Normal Linux starts, which
+# don't set it, keep spawning the server as a child.
+ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8 STRATA_EXECV=1
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        build-essential ca-certificates curl git libatomic1 libgomp1 \
+        python3 python3-pip python3-venv unzip \
+    && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /opt/strata
+COPY . .
+
+# GB10 is compute capability 12.1. BUILD_VISION=0 skips the image encoder build.
+ARG CUDA_ARCHITECTURES=121
+ARG BUILD_VISION=1
+
+RUN python3 -m venv .venv \
+    && .venv/bin/pip install --no-cache-dir --upgrade pip \
+    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
+    && chmod +x setup.sh docker-entrypoint.sh
+
+# llama.cpp at the pinned commit, then the engine and the image encoder, built
+# exactly the way setup.py builds them: native code for the CPU that builds the
+# image (ggml-cpu's -march from its /proc/cpuinfo, cmake/arm_arch.cmake), so build
+# it on the Spark it runs on. BUILD.json is what setup.py reads to
+# decide whether an engine is current: source=local with a matching src hash
+# means the first start reuses it instead of recompiling.
+RUN .venv/bin/python - <<'PYEOF'
+import json, os, pathlib, shutil
+import setup
+
+llama = setup.get_llama_cpp()
+nvcc, _ = setup.find_nvcc()
+arch = os.environ.get("CUDA_ARCHITECTURES", "121").strip().strip('"').replace(",", ";")
+vision = "gpu" if os.environ.get("BUILD_VISION", "1") == "1" else "none"
+
+setup.cmake_build(setup.ROOT, setup.ROOT / "build", "strata",
+    ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_BUILD_TESTS=OFF",
+     f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}",
+     f"-DSTRATA_GGML_DIR={llama}"], None, "build-strata.bat")
+if vision != "none":
+    setup.cmake_build(setup.ROOT / "tools" / "vision", setup.ROOT / "build-vision", "strata-vision",
+        [f"-DLLAMA_DIR={llama}", "-DSTRATA_VISION_CUDA=ON", "-DSTRATA_PORTABLE=OFF",
+         f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}"], None, "build-vision.bat")
+
+eng = setup.ROOT / "engine"
+eng.mkdir(exist_ok=True)
+shutil.copy2(setup.ROOT / "build" / setup.EXE, eng / setup.EXE)
+if vision != "none":
+    shutil.copy2(setup.ROOT / "build-vision" / "bin" / setup.VEXE, eng / setup.VEXE)
+bindir = pathlib.Path(nvcc).parent
+meta = {"source": "local", "version": setup.source_version(),
+        "archs": [int(a.split("-")[0]) for a in arch.split(";") if a.split("-")[0].isdigit()], "vision": vision,
+        "cuda_dirs": [str(d) for d in (bindir, bindir / "x64", bindir.parent / "lib64") if d.is_dir()],
+        "src": setup.source_hash(setup.ENGINE_SOURCES),
+        "vision_src": setup.source_hash(setup.VISION_SOURCES) if vision != "none" else None}
+(eng / "BUILD.json").write_text(json.dumps(meta, indent=1))
+PYEOF
+
+# the cmake trees are build-time only; the engine itself is what the container needs
+RUN rm -rf build build-vision
+
+VOLUME ["/data"]
+EXPOSE 8080
+
+# /health is answered before the API key gate, so it works with or without one.
+# The port only opens after the model loads (1-3 minutes, longer on a first run),
+# so the start period is generous: a too short one marks a still-loading container
+# unhealthy and a restart policy would kill it mid-download.
+HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
+  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1
+
+ENTRYPOINT ["./docker-entrypoint.sh"]
diff --git a/cmake/arm_arch.cmake b/cmake/arm_arch.cmake
new file mode 100644
index 0000000..891764f
--- /dev/null
+++ b/cmake/arm_arch.cmake
@@ -0,0 +1,31 @@
+# cmake/arm_arch.cmake - ggml-cpu's -march on aarch64 (docs/DGX_SPARK.md), for the engine and the vision encoder.
+#
+# GCC 13 does not know the GB10's Cortex-X925 / A725 cores: its -mcpu=native is plain ARMv8 (no dotprod, i8mm or SVE),
+# which ggml's native path keeps.  Both builds are compiled on the PC they run on, so -march is built from what this
+# CPU reports instead.  -DSTRATA_ARM_ARCH=<march> overrides it; -DSTRATA_ARM_ARCH=native keeps ggml's own detection.
+function(strata_arm_ggml_arch)
+  if(NOT DEFINED STRATA_ARM_ARCH)
+    set(_arm_arch "armv8.2-a")
+    if(EXISTS /proc/cpuinfo)
+      file(STRINGS /proc/cpuinfo _arm_features REGEX "^Features" LIMIT_COUNT 1)
+      string(REGEX REPLACE "^Features[ \t]*:[ \t]*" "" _arm_features "${_arm_features}")
+      separate_arguments(_arm_features)
+      foreach(_p "asimddp;dotprod" "asimdhp;fp16" "i8mm;i8mm" "bf16;bf16" "sve;sve" "sve2;sve2")
+        list(GET _p 0 _flag)
+        list(GET _p 1 _ext)
+        if(_flag IN_LIST _arm_features)
+          string(APPEND _arm_arch "+${_ext}")
+        endif()
+      endforeach()
+    endif()
+    set(STRATA_ARM_ARCH "${_arm_arch}" CACHE STRING "aarch64 -march for ggml-cpu (native: ggml's -mcpu=native)")
+  endif()
+  if(STRATA_ARM_ARCH STREQUAL "native")
+    message(STATUS "Strata aarch64: ggml-cpu -mcpu=native (ggml's own detection)")
+    set(GGML_NATIVE ON CACHE BOOL "" FORCE)
+  else()
+    message(STATUS "Strata aarch64: ggml-cpu -march=${STRATA_ARM_ARCH}")
+    set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
+    set(GGML_CPU_ARM_ARCH "${STRATA_ARM_ARCH}" CACHE STRING "" FORCE)
+  endif()
+endfunction()
diff --git a/docker-compose.spark.yml b/docker-compose.spark.yml
new file mode 100644
index 0000000..f8b454a
--- /dev/null
+++ b/docker-compose.spark.yml
@@ -0,0 +1,54 @@
+# Strata on an NVIDIA DGX Spark (docs/DGX_SPARK.md), with Docker Compose.  Run from the project root, ON THE SPARK:
+#
+#   mkdir -p strata-data                                  # so the folder is yours, not root's
+#   docker compose -f docker-compose.spark.yml up -d --build
+#   docker compose -f docker-compose.spark.yml logs -f
+#   curl -fs http://127.0.0.1:8080/health
+#
+# The model files, the pack and the install config live in ./strata-data (the container's /data), beside the source
+# and outside the image: .dockerignore and .gitignore leave that folder out.  The first start sets the model up there
+# (UD-IQ4_XS downloads 94 GB unless GGUF_DIR points at files you already have); later starts serve straight away.
+#
+# Settings come from the environment or a .env file next to this one: `cp .env.example .env` and edit it (it lists
+# every setting with its default; .env is kept out of git and out of the image).
+# REINSTALL=1 changes the settings of a model that is already set up.  Q2_0 is not offered on ARM (its pack needs x86
+# AVX-512).  The port is published on 127.0.0.1 only: set API_KEY before opening it to a network.
+
+services:
+  strata:
+    build:
+      context: .
+      dockerfile: Dockerfile.spark
+      args:
+        CUDA_ARCHITECTURES: "121"
+        BUILD_VISION: "${BUILD_VISION:-1}"         # 0: no image encoder, a faster build
+    image: strata-spark
+    container_name: strata
+    restart: unless-stopped
+    ports:
+      - "127.0.0.1:${STRATA_PORT:-8080}:8080"
+    ulimits:
+      memlock:                                     # the engine locks part of the RAM for the GPU
+        soft: -1
+        hard: -1
+    volumes:
+      - ./strata-data:/data
+      # GGUF files you already have (then set GGUF_DIR=/ggufs):
+      # - /path/to/ggufs:/ggufs:ro
+    environment:
+      FAMILY: "${FAMILY:-unsloth}"
+      MODEL: "${MODEL:-UD-IQ4_XS}"
+      CONTEXT: "${CONTEXT:-65536}"
+      VISION: "${VISION:-no}"
+      API_KEY: "${API_KEY:-}"
+      GGUF_DIR: "${GGUF_DIR:-}"
+      KV: "${KV:-}"
+      MODEL_ALIASES: "${MODEL_ALIASES:-}"
+      REINSTALL: "${REINSTALL:-0}"
+    deploy:
+      resources:
+        reservations:
+          devices:
+            - driver: nvidia
+              count: all
+              capabilities: [gpu]
