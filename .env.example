# Settings for docker-compose.spark.yml (Strata on a DGX Spark, docs/DGX_SPARK.md).
# Copy this file to .env in the project root and change what you need; Docker Compose reads .env by itself:
#   cp .env.example .env
# .env holds your API key, so .gitignore and .dockerignore leave it out of git and out of the image.
# Every line is optional: an unset one takes the default shown.

# ---- the model (read by the container's first start; later starts reuse the setup in ./strata-data) ----

# qwen | swift | coder | unsloth
FAMILY=unsloth
# unsloth: UD-IQ4_XS (94 GB download, all its experts fit in the Spark's memory) or UD-Q4_K_XL (experimental)
# qwen: IQ2_XS, IQ3_XXS or IQ3_S.  Not Q2_0: its pack needs x86 AVX-512 (not on ARM)
MODEL=UD-IQ4_XS
# the longest conversation in tokens (prompt + answer)
CONTEXT=204800
# no | yes | cpu: reading pictures (yes needs BUILD_VISION=1)
VISION=yes
# KV cache: empty (setup's default, int8) | int8 | q4_0 | k8v4
KV=
# from a 64K context: keep the KV cache in RAM and only the attention's window in GPU memory (more experts fit on the
# GPU). empty (setup's default, auto: when the RAM has room) | auto | on | off. The Spark's GPU memory IS the RAM, so
# this saves nothing there; not measured either way
KV_STREAMING=
# read the experts from the model's files instead of copying them all into RAM, for a PC with little RAM:
# auto (when they would not fit) | on | off | resident | mmap. Every model fits the Spark's 128 GB, so auto keeps it off
LOW_RAM=auto
# UD-IQ4_XS / UD-Q4_K_XL: the GiB of the experts kept in RAM, the rest read from the SSD. empty: setup's pick (the RAM
# less 24 GB, at most all of them: 55 for UD-IQ4_XS, which is all of its experts on the Spark)
RESIDENT_BUDGET_GIB=

# GGUF files you already have, so nothing is downloaded: the path INSIDE the container. Uncomment the /ggufs mount in
# docker-compose.spark.yml (with the folder on the Spark), then set GGUF_DIR=/ggufs
GGUF_DIR=

# 1: run setup again on the next start, to change CONTEXT, VISION, KV, KV_STREAMING, LOW_RAM, RESIDENT_BUDGET_GIB or
# API_KEY for a model already set up.
# Set it back to 0 afterwards
REINSTALL=0

# ---- memory (the Spark's GPU shares the RAM: docs/DGX_SPARK.md) ----

# the GPU's copy of the most-used experts (--expert-cache): empty (keep the config's, auto after setup) | auto | N.
# auto takes the memory left after the model loads, less UMA_HEADROOM_GIB, up to every expert: with UD-IQ4_XS on the
# Spark that is all 24576 of them (55 GiB, measured), a second copy beside the OS file cache's. N is a number of slots
# of one expert each; the engine's log says what auto chose ("expert cache auto: ... -> N slots")
EXPERT_CACHE=
# the GiB of RAM kept for the OS and other programs when the engine sizes GPU memory (0-1024, default 6)
UMA_HEADROOM_GIB=6

# ---- the server ----

# requests served at once (the config's "parallel", docs/BATCHING.md): empty (keep the config's; one at a time after
# setup) | 1 | 2..8. With N, up to N conversations decode together and more wait their turn; each slot takes ~0.6 GB at
# a 32K context, and with KV streaming its whole KV cache also sits in RAM (~2.5 GB at 200K). Applied on every start,
# no REINSTALL. Not measured on the Spark yet
PARALLEL=

# other names the model answers to and /v1/models lists, comma-separated (its own name stays, for example
# qwen3.8-flash-next-unsloth-ud-iq4_xs). A request naming an alias is answered under that name. Set, it replaces the
# config's aliases on every start; empty, the config's own (set in the web page's About tab) are kept
MODEL_ALIASES=

# required by every /v1 request when set (Authorization: Bearer <key>, or an x-api-key header). Applied on every
# start, so changing it needs no REINSTALL. Required when STRATA_BIND opens the port to the network
API_KEY=
# the address on the Spark the port is published on: 127.0.0.1 (this machine only) | 0.0.0.0 (every network
# interface: other machines reach it at http://<the Spark's IP>:STRATA_PORT/v1) | one interface's IP.
# Anything but 127.0.0.1 needs API_KEY: the container refuses to start without one
STRATA_BIND=127.0.0.1
# the port on the Spark
STRATA_PORT=8080
# host names other machines use to reach the server, comma-separated (an IP address always works; a name such as
# spark-home.local is refused unless listed, a guard against DNS rebinding). "*" allows any name
ALLOWED_HOSTS=

# ---- the image build ----

# 1: build the image encoder (needed for VISION=yes); 0: a faster build without it
BUILD_VISION=1
